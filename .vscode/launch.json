{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (OIM.Api)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/sources/OIM.Api/bin/Debug/net10.0/OIM.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/sources/OIM.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      }
    },
    {
      "name": "API (attach)",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
