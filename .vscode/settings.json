{
  "dotnet.defaultSolution": "OIM.slnx",

  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/node_modules": true,
    "**/*.lscache": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/package-lock.json": true,
    "**/*.db": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  },

  "yaml.schemas": {
    "./workflows/workflow-schema.json": [
      "workflows/workflow*.yml",
      "deploiement/**/workflow.yml"
    ]
  },

  "files.associations": {
    "*.slnx": "xml"
  },

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.csproj": "${basename}.csproj.user, ${basename}.csproj.lscache",
    "package.json": "package-lock.json, vite.config.js",
    "*.db": "${basename}.db-shm, ${basename}.db-wal"
  }
}
