{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/OIM.slnx", "-v", "q", "--nologo"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/OIM.slnx", "--nologo"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/sources/OIM.Api/OIM.Api.csproj"],
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "frontend: dev",
      "type": "npm",
      "script": "dev",
      "path": "sources/OIM.Frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*ready in.*"
        }
      },
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "frontend: build",
      "type": "npm",
      "script": "build",
      "path": "sources/OIM.Frontend",
      "problemMatcher": []
    },
    {
      "label": "dev (api + frontend)",
      "dependsOn": ["api: watch", "frontend: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
