      Executing DbCommand [Parameters=[@id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT "s"."Id", "s"."ContexteExecution", "s"."CorrelationId", "s"."DateCreation", "s"."DateDebut", "s"."DateFin", "s"."DefinitionWorkflowId", "s"."DonneesEntree", "s"."Erreur", "s"."Etat", "s"."HashVersionConfig", "s"."Id0", "e"."Id", "e"."DateDebut", "e"."DateFin", "e"."DonneesEntree", "e"."DonneesSortie", "e"."Erreur", "e"."Etat", "e"."InstanceWorkflowId", "e"."NomTache", "e"."NombreTentatives", "e"."Ordre", "e"."TypeConnecteur", "s"."Actif", "s"."ContenuYaml", "s"."DateCreation0", "s"."DateModification", "s"."Description", "s"."Equipe", "s"."HashVersion", "s"."Nom"
      FROM (
          SELECT "i"."Id", "i"."ContexteExecution", "i"."CorrelationId", "i"."DateCreation", "i"."DateDebut", "i"."DateFin", "i"."DefinitionWorkflowId", "i"."DonneesEntree", "i"."Erreur", "i"."Etat", "i"."HashVersionConfig", "d"."Id" AS "Id0", "d"."Actif", "d"."ContenuYaml", "d"."DateCreation" AS "DateCreation0", "d"."DateModification", "d"."Description", "d"."Equipe", "d"."HashVersion", "d"."Nom"
          FROM "InstancesWorkflow" AS "i"
          INNER JOIN "DefinitionsWorkflow" AS "d" ON "i"."DefinitionWorkflowId" = "d"."Id"
          WHERE "i"."Id" = @id
          LIMIT 1
      ) AS "s"
      LEFT JOIN "ExecutionsTache" AS "e" ON "s"."Id" = "e"."InstanceWorkflowId"
      ORDER BY "s"."Id", "s"."Id0", "e"."Ordre"
