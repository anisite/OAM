      SELECT "d0"."Id", "d0"."Actif", "d0"."ContenuYaml", "d0"."DateCreation", "d0"."DateModification", "d0"."Description", "d0"."Equipe", "d0"."HashVersion", "d0"."Nom", "v1"."Id", "v1"."ContenuYaml", "v1"."DateChargement", "v1"."DefinitionWorkflowId", "v1"."DeployePar", "v1"."HashVersion"
      FROM (
          SELECT "d"."Id", "d"."Actif", "d"."ContenuYaml", "d"."DateCreation", "d"."DateModification", "d"."Description", "d"."Equipe", "d"."HashVersion", "d"."Nom"
          FROM "DefinitionsWorkflow" AS "d"
          WHERE "d"."Id" = @id
          LIMIT 1
      ) AS "d0"
      LEFT JOIN (
          SELECT "v0"."Id", "v0"."ContenuYaml", "v0"."DateChargement", "v0"."DefinitionWorkflowId", "v0"."DeployePar", "v0"."HashVersion"
          FROM (
              SELECT "v"."Id", "v"."ContenuYaml", "v"."DateChargement", "v"."DefinitionWorkflowId", "v"."DeployePar", "v"."HashVersion", ROW_NUMBER() OVER(PARTITION BY "v"."DefinitionWorkflowId" ORDER BY "v"."DateChargement" DESC) AS "row"
