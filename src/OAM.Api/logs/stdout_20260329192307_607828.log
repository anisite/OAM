          SELECT "i"."Id", "i"."ContexteExecution", "i"."CorrelationId", "i"."DateCreation", "i"."DateDebut", "i"."DateFin", "i"."DefinitionWorkflowId", "i"."DonneesEntree", "i"."Erreur", "i"."Etat", "i"."HashVersionConfig", "d"."Id" AS "Id0", "d"."Actif", "d"."ContenuYaml", "d"."DateCreation" AS "DateCreation0", "d"."DateModification", "d"."Description", "d"."Equipe", "d"."HashVersion", "d"."Nom"
          FROM "InstancesWorkflow" AS "i"
          INNER JOIN "DefinitionsWorkflow" AS "d" ON "i"."DefinitionWorkflowId" = "d"."Id"
          WHERE "i"."Id" = @id
          LIMIT 1
      ) AS "s"
      LEFT JOIN "ExecutionsTache" AS "e" ON "s"."Id" = "e"."InstanceWorkflowId"
      ORDER BY "s"."Id", "s"."Id0", "e"."Ordre"
